# OvenClear storefront configuration.
# Copy to .env for local work. NEVER commit a filled-in copy — .env is gitignored.
# On Cloud Run these come from Secret Manager, not from a file.

# --- required in production; the server refuses to boot without them ---------

# Public origin of the deployed service. Stripe redirect URLs and the QR
# provenance links are built from this, so it must be the real https URL.
BASE_URL=https://ovenclear-xxxxxxxxxx-uc.a.run.app

# Stripe. Use sk_test_... until you are ready to take real money.
# The webhook secret comes from the endpoint you create in the Stripe dashboard
# pointing at $BASE_URL/webhooks/stripe.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Ed25519 ledger key namespace. Agent signing keys are derived from this
# string, so treat it as a secret: anyone who knows it can forge ledger rows.
# Generate once and never rotate casually — rotating it invalidates every
# signature already published.
#   openssl rand -hex 32
LEDGER_KEY_NAMESPACE=

# --- optional ----------------------------------------------------------------

# Live Gemini. Without it the service still serves verdicts and labels: the
# deterministic core needs no model. With it, unknown free-text products get a
# catalog-constrained rescue pass and law-watch deltas get classified live.
GEMINI_API_KEY=

# Where orders.jsonl and ledger.jsonl are written. On Cloud Run point this at a
# mounted GCS bucket — the container filesystem does not survive a restart.
DATA_DIR=/tmp/ovenclear

PORT=8080
PRICE_USD=19
SUPPORT_EMAIL=support@ovenclear.com
